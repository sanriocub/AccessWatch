@model AccessWatch.Models.AccessibilityReport

@{
    ViewData["Title"] = "Inspection Findings";
}

<h2>Inspection Findings</h2>

<p>Complete the accessibility inspection for this report.</p>

@if (TempData["Error"] != null)
{
    <div class="alert alert-danger">
        @TempData["Error"]
    </div>
}

<div class="card mb-4">
    <div class="card-body">
        <h5 class="card-title">Report Details</h5>

        <p>
            <strong>Report ID:</strong>
            @Model.ReportId
        </p>

        <p>
            <strong>Submitted By:</strong>
            @Model.SubmittedBy?.Name
        </p>

        <p>
            <strong>Description:</strong>
            @Model.Description
        </p>

        @if (Model.Facility != null)
        {
            <p>
                <strong>Facility:</strong>
                @Model.Facility.Name
            </p>
        }

        @if (Model.Category != null)
        {
            <p>
                <strong>Category:</strong>
                @Model.Category.Name
            </p>
        }

        <p>
            <strong>Status:</strong>
            @Model.Status
        </p>
    </div>
</div>

<form asp-controller="Inspection"
      asp-action="SubmitInspection"
      method="post">

    <input type="hidden"
           name="reportId"
           value="@Model.ReportId" />

    <!-- Function 3: Submit Inspection Findings -->
    <div class="mb-3">
        <label class="form-label">
            Inspection Findings
        </label>

        <textarea name="findings"
                  class="form-control"
                  rows="5"
                  maxlength="1000"
                  required
                  placeholder="Describe your inspection findings..."></textarea>
    </div>

    <!-- Function 4: Provide Accessibility Rating -->
    <div class="mb-3">
        <label class="form-label">
            Accessibility Rating
        </label>

        <select name="accessibilityRating"
                class="form-select"
                required>
            <option value="">Select rating...</option>
            <option value="1">1 - Very Poor</option>
            <option value="2">2 - Poor</option>
            <option value="3">3 - Average</option>
            <option value="4">4 - Good</option>
            <option value="5">5 - Excellent</option>
        </select>
    </div>

    <!-- Function 5: Recommend Corrective Action -->
    <div class="mb-3">
        <label class="form-label">
            Recommended Corrective Action
        </label>

        <textarea name="recommendedAction"
                  class="form-control"
                  rows="4"
                  maxlength="1000"
                  required
                  placeholder="Enter the recommended corrective action..."></textarea>
    </div>

    <!-- Function 6: Forward Issue for Maintenance -->
    <div class="form-check mb-3">
        <input class="form-check-input"
               type="checkbox"
               name="forwardedForMaintenance"
               value="true"
               id="forwardedForMaintenance" />

        <label class="form-check-label"
               for="forwardedForMaintenance">
            Forward this issue to Facility Maintenance
        </label>
    </div>

    <button type="submit"
            class="btn btn-success">
        Submit Inspection
    </button>

    <a asp-controller="Inspection"
       asp-action="Index"
       class="btn btn-secondary">
        Back
    </a>
</form>