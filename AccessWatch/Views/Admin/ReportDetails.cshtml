@model AccessWatch.Models.AccessibilityReport
@{
    ViewData["Title"] = "Report Details";
}

<h2>Report Details</h2>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">Submission</h5>
        <dl class="row mb-0">
            <dt class="col-sm-3">Report ID</dt>
            <dd class="col-sm-9">@Model.ReportId</dd>

            <dt class="col-sm-3">Submitted By</dt>
            <dd class="col-sm-9">@Model.SubmittedBy?.Name (@Model.SubmittedBy?.Email)</dd>

            <dt class="col-sm-3">Submitted At</dt>
            <dd class="col-sm-9">@Model.SubmittedAt.ToLocalTime().ToString("g")</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9 text-break">@Model.Description</dd>

            <dt class="col-sm-3">Facility</dt>
            <dd class="col-sm-9">@(Model.Facility?.Name ?? "Not specified")</dd>

            <dt class="col-sm-3">Category</dt>
            <dd class="col-sm-9">@(Model.Category?.Name ?? "Not specified")</dd>

            <dt class="col-sm-3">Current Status</dt>
            <dd class="col-sm-9"><span class="badge bg-secondary">@Model.Status</span></dd>
        </dl>

        @if (!string.IsNullOrWhiteSpace(Model.ImageUrl))
        {
            <div class="mt-3">
                <strong>Reported Barrier Photo</strong>
                <div class="mt-2">
                    <a href="@Model.ImageUrl" target="_blank" rel="noopener noreferrer">
                        <img src="@Model.ImageUrl" class="img-fluid rounded border" style="max-height:280px" />
                    </a>
                </div>
            </div>
        }
    </div>
</div>

<div class="card mb-3">
    <div class="card-body">
        <h5 class="card-title">Review &amp; Assignment</h5>
        <dl class="row mb-0">
            <dt class="col-sm-3">Reviewed By</dt>
            <dd class="col-sm-9">@(Model.ReviewedBy?.Name ?? "Not yet reviewed")</dd>

            <dt class="col-sm-3">Decision</dt>
            <dd class="col-sm-9">
                @(Model.ReviewApproved == null ? "Pending" : Model.ReviewApproved == true ? "Approved" : "Rejected")
            </dd>

            <dt class="col-sm-3">Assigned Inspector</dt>
            <dd class="col-sm-9">@(Model.AssignedInspector?.Name ?? "Not yet assigned")</dd>
        </dl>
    </div>
</div>

@if (Model.Inspection != null)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Inspection</h5>
            <dl class="row mb-0">
                <dt class="col-sm-3">Findings</dt>
                <dd class="col-sm-9 text-break">@Model.Inspection.Findings</dd>

                <dt class="col-sm-3">Accessibility Rating</dt>
                <dd class="col-sm-9">@Model.Inspection.AccessibilityRating / 5</dd>

                <dt class="col-sm-3">Recommended Action</dt>
                <dd class="col-sm-9 text-break">@Model.Inspection.RecommendedAction</dd>

                <dt class="col-sm-3">Forwarded for Maintenance</dt>
                <dd class="col-sm-9">
                    @if (Model.Inspection.ForwardedForMaintenance)
                    {
                        <span class="badge bg-warning text-dark">Yes</span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">No</span>
                    }
                </dd>

                <dt class="col-sm-3">Inspected At</dt>
                <dd class="col-sm-9">@Model.Inspection.InspectedAt?.ToLocalTime().ToString("g")</dd>
            </dl>
        </div>
    </div>
}

@if (Model.Repair != null)
{
    <div class="card mb-3">
        <div class="card-body">
            <h5 class="card-title">Repair</h5>
            <dl class="row mb-0">
                <dt class="col-sm-3">Maintenance Officer</dt>
                <dd class="col-sm-9">@Model.Repair.MaintenanceOfficer?.Name</dd>

                <dt class="col-sm-3">Progress</dt>
                <dd class="col-sm-9">@Model.Repair.Progress</dd>

                <dt class="col-sm-3">Corrective Actions</dt>
                <dd class="col-sm-9 text-break">@Model.Repair.CorrectiveActions</dd>

                <dt class="col-sm-3">Completed</dt>
                <dd class="col-sm-9">@(Model.Repair.IsCompleted ? "Yes" : "Not yet")</dd>

                <dt class="col-sm-3">Completed At</dt>
                <dd class="col-sm-9">@(Model.Repair.CompletedAt?.ToLocalTime().ToString("g") ?? "-")</dd>
            </dl>

            @if (!string.IsNullOrWhiteSpace(Model.Repair.CompletionEvidenceUrl))
            {
                <div class="mt-3">
                    <strong>Repair Evidence Photo</strong>
                    <div class="mt-2">
                        <a href="@Model.Repair.CompletionEvidenceUrl" target="_blank" rel="noopener noreferrer">
                            <img src="@Model.Repair.CompletionEvidenceUrl" class="img-fluid rounded border" style="max-height:280px" />
                        </a>
                    </div>
                </div>
            }
        </div>
    </div>
}

<a asp-controller="Admin" asp-action="Index" class="btn btn-link">Back to dashboard</a>