@model List<AccessWatch.Models.AccessibilityReport>
@{
    ViewData["Title"] = "Admin Dashboard";
}

<h2 class="mb-4">Platform Dashboard</h2>

<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card p-3">
            <h3>@ViewBag.TotalUsers</h3>
            <span class="text-muted">Users</span>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card p-3">
            <h3>@ViewBag.TotalReports</h3>
            <span class="text-muted">Total reports</span>
        </div>
    </div>
</div>

<h5 class="text-muted mb-3">Reports by status</h5>
<div class="row g-3 mb-4">
    <div class="col-6 col-md-3">
        <div class="card p-3">
            <h3>@ViewBag.Submitted</h3>
            <span class="text-muted">Submitted</span>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card p-3">
            <h3>@ViewBag.UnderReview</h3>
            <span class="text-muted">Under review</span>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card p-3">
            <h3>@ViewBag.Rejected</h3>
            <span class="text-muted">Rejected</span>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card p-3">
            <h3>@ViewBag.Assigned</h3>
            <span class="text-muted">Assigned</span>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card p-3">
            <h3>@ViewBag.InProgress</h3>
            <span class="text-muted">In progress</span>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card p-3">
            <h3>@ViewBag.Inspected</h3>
            <span class="text-muted">Inspected</span>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card p-3">
            <h3>@ViewBag.InRepair</h3>
            <span class="text-muted">In repair</span>
        </div>
    </div>
    <div class="col-6 col-md-3">
        <div class="card p-3">
            <h3>@ViewBag.Completed</h3>
            <span class="text-muted">Completed</span>
        </div>
    </div>
</div>

<p>
    <a asp-controller="Admin" asp-action="ReviewReports" class="btn btn-primary">Review reports</a>
    <a asp-controller="Admin" asp-action="ManageUsers" class="btn btn-outline-secondary">Manage users</a>
    <a asp-controller="Admin" asp-action="ManageCategories" class="btn btn-outline-secondary">Manage categories</a>
</p>

<h4>Recent activity</h4>
<table class="table">
    <thead>
        <tr><th>Submitted</th><th>By</th><th>Description</th><th>Status</th><th></th></tr>
    </thead>
    <tbody>
        @foreach (var r in Model)
        {
            <tr>
                <td>@r.SubmittedAt.ToLocalTime().ToString("g")</td>
                <td>@r.SubmittedBy?.Name</td>
                <td>@(r.Description.Length > 50 ? r.Description.Substring(0, 50) + "..." : r.Description)</td>
                <td><span class="badge bg-secondary">@r.Status</span></td>
                <td><a asp-controller="Admin" asp-action="ReportDetails" asp-route-id="@r.ReportId">View</a></td>
            </tr>
        }
    </tbody>
</table>